{
  "manifest_version": 3,
  "name": "Cooks",
  "version": "1.0.0",
  "description": "Discover recipes for dishes you find online.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cooks"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "render-recipe.js",
        "shadow-card.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}